<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.concurrency.practice</groupId>
    <artifactId>java-concurrency-practice</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>beginner/01-thread-basics</module>
        <module>beginner/02-runnable-vs-thread</module>
        <module>beginner/03-synchronized-counter</module>
        <module>beginner/04-producer-consumer-basic</module>
        <module>beginner/05-thread-join</module>
        <module>beginner/06-volatile-keyword</module>
        <module>beginner/07-daemon-threads</module>
        <module>beginner/08-thread-interrupt</module>
        <module>beginner/09-atomic-integer</module>
        <module>beginner/10-thread-local</module>
        <module>beginner/11-reentrant-lock</module>
        <module>beginner/12-read-write-lock</module>
        <module>beginner/13-countdown-latch</module>
        <module>beginner/14-thread-safe-singleton</module>
        <module>beginner/15-fizzbuzz-threads</module>
        <module>intermediate/16-semaphore</module>
        <module>intermediate/17-cyclic-barrier</module>
        <module>intermediate/18-executor-service</module>
        <module>intermediate/19-future-callable</module>
        <module>intermediate/20-fork-join-pool</module>
        <module>intermediate/21-blocking-queue</module>
        <module>intermediate/22-exchanger</module>
        <module>intermediate/23-phaser</module>
        <module>intermediate/24-stamped-lock</module>
        <module>intermediate/25-concurrent-hashmap</module>
        <module>advanced/26-lock-free-stack</module>
        <module>advanced/27-java-memory-model</module>
        <module>advanced/28-deadlock-detection</module>
        <module>advanced/29-scheduled-executor</module>
        <module>advanced/30-custom-thread-pool</module>
    </modules>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <junit.version>5.10.0</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.1.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
